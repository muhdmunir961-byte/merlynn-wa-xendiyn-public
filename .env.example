NODE_ENV=development
HOST=0.0.0.0
PORT=3000
AUTH_DIR=./auth_info
DATA_FILE=./data/state.json
COMMAND_PREFIX=.
OUTGOING_MIN_DELAY_MS=400
OUTGOING_JITTER_MS=900
LOG_LEVEL=info

# Store identity / wording
STORE_NAME=Merlynn Store
STORE_TAGLINE=lovely · trustable · fast
STORE_KEYWORD=merlynn
STORE_OWNER=Owner
STORE_CONTACT=
STORE_RULES=
WORDING_STYLE=soft

# Voice order: wake word must be spoken before the instruction
WAKE_WORD=merlynn
# OpenAI-compatible speech-to-text endpoint (faster-whisper-server / whisper.cpp / OpenAI)
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=whisper-1
STT_LANGUAGE=id
STT_TIMEOUT_MS=60000
# Interactive WhatsApp lists (falls back to text automatically)
ENABLE_LIST_MESSAGES=true
# Web dashboard socket auth token (optional)
DASHBOARD_WS_TOKEN=
STORE_TIMEZONE=Asia/Jakarta
ORDER_ALLOW_PUBLIC=false
ORDER_MAX_QTY=5
USER_RATE_LIMIT=20

# Payment block shown by .pay / .deposit
PAYMENT_QRIS_NOTE=qris diatas khusus dana
PAYMENT_DANA=
PAYMENT_GOPAY=
PAYMENT_SHOPEEPAY=
PAYMENT_SEABANK=
PAYMENT_ADMIN_FEE=1.000
DIGIFLAZZ_USERNAME=your-digiflazz-username
DIGIFLAZZ_API_KEY=replace-with-secret
DIGIFLAZZ_BASE_URL=https://api.digiflazz.com/v1
# Optional webhook HMAC secret for POST /webhooks/digiflazz (Digiflazz sends X-Hub-Signature: sha1=...)
DIGIFLAZZ_WEBHOOK_SECRET=

# Optional local-only Ollama LLM (no credentials required)
LLM_ENABLED=false
LLM_BASE_URL=http://10.3.20.12:11434
LLM_MODEL=qwen2.5:0.5b
LLM_API_KEY=
LLM_TIMEOUT_MS=60000
LLM_RATE_LIMIT_MS=15000
LLM_HISTORY_LIMIT=6
# LLM_SYSTEM_PROMPT=
