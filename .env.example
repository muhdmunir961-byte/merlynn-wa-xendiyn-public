NODE_ENV=development
HOST=0.0.0.0
PORT=3000
AUTH_DIR=./auth_info
DATA_FILE=./data/state.json
COMMAND_PREFIX=.
OUTGOING_MIN_DELAY_MS=400
OUTGOING_JITTER_MS=900
LOG_LEVEL=info
DIGIFLAZZ_USERNAME=your-digiflazz-username
DIGIFLAZZ_API_KEY=replace-with-secret
DIGIFLAZZ_BASE_URL=https://api.digiflazz.com/v1
# Optional webhook HMAC secret for POST /webhooks/digiflazz (Digiflazz sends X-Hub-Signature: sha1=...)
DIGIFLAZZ_WEBHOOK_SECRET=

# Optional local-only Ollama LLM (no credentials required)
LLM_ENABLED=false
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=llama3.2
LLM_RATE_LIMIT_MS=15000
LLM_HISTORY_LIMIT=6
# LLM_SYSTEM_PROMPT=
